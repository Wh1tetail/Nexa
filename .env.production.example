# Settings for docker-compose.yml. Copy to `.env` next to docker-compose.yml and fill in.
# `.env` is git-ignored — never commit real secrets.

# Public address of the site (used in e-mail links and CORS).
# With the domain: PUBLIC_URL=https://nexalanguage.com
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
# 0.0.0.0 = nginx reachable from outside on HTTP_PORT; set 127.0.0.1 when Caddy (HTTPS) is in front
HTTP_BIND=0.0.0.0

# HTTPS (docker compose --profile https up -d): domain without https://: nexalanguage.com
# Its DNS A record must point to this server; ports 80 and 443 must be open.
DOMAIN=

# PostgreSQL inside the stack
POSTGRES_DB=nexa
POSTGRES_USER=nexa
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# JWT signing key, at least 32 characters
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DEFAULT_TIMEZONE=Asia/Almaty
WEB_CONCURRENCY=2

# E-mail: console (letters go to `docker compose logs backend`) or smtp
EMAIL_BACKEND=console
# E-mail copies of notifications / chat messages still unread after the delay
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFY_DELAY_MINUTES=10
# Delete stored files no database row refers to (hours; 0 = off)
STORAGE_SWEEP_INTERVAL_HOURS=24
EMAIL_FROM=NEXA <no-reply@nexalanguage.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Port 587: SMTP_STARTTLS=true, SMTP_SSL=false. Port 465: SMTP_SSL=true.
SMTP_STARTTLS=true
SMTP_SSL=false

# File storage: local (docker volume) or s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Book-to-Test PDF books (nginx accepts uploads up to 210 MB on /api/v1/books)
BOOK_MAX_UPLOAD_MB=200
BOOK_MAX_PAGES=500

# AI question generation (Book-to-Test). The key stays on the server.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# JSON list of models tried after AI_MODEL, e.g. ["claude-opus-5-5"]; [] = off
AI_FALLBACK_MODELS=[]
AI_MAX_QUESTIONS_PER_JOB=50
AI_MAX_PAGES_PER_JOB=30
AI_MAX_RETRIES=3

# Backups (the `backup` service): folder on the server, how often, how long to keep
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
