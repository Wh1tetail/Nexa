# ---- Application ----
ENVIRONMENT=development
DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/english_lms

# ---- CORS / Frontend ----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173

# ---- File storage ----
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=10
# S3-compatible storage (AWS S3, MinIO, Yandex Object Storage, ...)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- E-mail ----
# console = letters are written to the server log (development)
# smtp    = real delivery via SMTP_* below
EMAIL_BACKEND=console
# E-mail copies of notifications / chat messages still unread after the delay
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFY_DELAY_MINUTES=10
# Delete stored files no database row refers to (hours; 0 = off)
STORAGE_SWEEP_INTERVAL_HOURS=24
EMAIL_FROM=NEXA <no-reply@nexalanguage.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS on port 587, or SMTP_SSL=true for port 465
SMTP_STARTTLS=true
SMTP_SSL=false
PASSWORD_RESET_EXPIRE_MINUTES=60
INVITE_EXPIRE_HOURS=72

# ---- Real-time notifications (PostgreSQL LISTEN/NOTIFY -> SSE) ----
REALTIME_ENABLED=true

# ---- Subscriptions ----
SUBSCRIPTION_EXPIRING_DAYS=7
SUBSCRIPTION_CHECK_INTERVAL_MINUTES=60

# ---- Book-to-Test: PDF books ----
BOOK_MAX_UPLOAD_MB=200
BOOK_MAX_PAGES=500
# a page with fewer characters of text than this is treated as a scan (needs OCR)
BOOK_OCR_MIN_CHARS=30
# worker: python -m app.worker
BOOK_WORKER_CONCURRENCY=1
# seconds between queue checks when the worker is idle
BOOK_WORKER_POLL_SECONDS=3
BOOK_JOB_MAX_ATTEMPTS=3
BOOK_JOB_STALE_MINUTES=15
# OCR for scanned pages (services/ocr_service.py). Locally it needs Tesseract on PATH
# with eng/rus/kaz data; without it leave OCR off and scans are only marked.
OCR_ENABLED=false
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng+rus+kaz
OCR_PAGE_TIMEOUT_SECONDS=120

# ---- AI: Book-to-Test question generation (key stays on the server) ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# JSON list of models tried after AI_MODEL, e.g. ["claude-opus-5-5"]; [] = off
AI_FALLBACK_MODELS=[]
AI_MAX_QUESTIONS_PER_JOB=50
AI_MAX_PAGES_PER_JOB=30
AI_MAX_RETRIES=3
AI_PAGES_PER_REQUEST=10
# JSON list of question types methodists may generate
AI_QUESTION_TYPES=["single_choice","multiple_choice","true_false"]
# one AI request: seconds before it times out, most tokens in the answer
AI_TIMEOUT_SECONDS=300
AI_MAX_OUTPUT_TOKENS=32000
# JSON price overrides in USD per million tokens, for cost estimates only;
# e.g. {"claude-sonnet-5-5": {"input": 3, "output": 15}}; {} = built-in table
AI_PRICES={}
